(version 1)

# JLCPCB rigid FR-4, four layers, 1 oz outer / 0.5 oz inner copper.
# Source: https://jlcpcb.com/capabilities/pcb-capabilities (checked 2026-11-11).
# This supplements the project constraints and netclasses in the .kicad_pro file.
# Keep the HV_48V netclass clearance of 0.65 mm. Do not add a generic
# clearance rule here, because it could override that larger netclass value.

# JLCPCB's absolute multilayer 1 oz PTH annular-ring minimum is 0.15 mm;
# 0.20 mm or more is recommended for plated through-hole pads.
(rule "JLCPCB 4L 1oz annular ring"
    (constraint annular_width (min 0.15mm)))

# The JLCPCB pad-hole spacing minimum is 0.45 mm. The project-wide 0.25 mm
# floor still applies to via-via holes (JLCPCB publishes 0.20 mm for those).
(rule "JLCPCB pad hole to hole"
    (condition "A.Type == 'Pad' || B.Type == 'Pad'")
    (constraint hole_to_hole (min 0.45mm)))

# PTH drill-to-inner-copper minimum, measured from the drill edge.
(rule "JLCPCB inner PTH hole to copper"
    (layer inner)
    (condition "A.Pad_Type == 'Through-hole' || B.Pad_Type == 'Through-hole'")
    (constraint hole_clearance (min 0.30mm)))

# A circular NPTH must be at least 0.50 mm in diameter.
(rule "JLCPCB round NPTH minimum"
    (condition "A.Pad_Type == 'NPTH, mechanical' && A.Hole_Size_X == A.Hole_Size_Y")
    (constraint hole_size (min 0.50mm)))

# JLCPCB's multilayer plated-slot width minimum is 0.35 mm; its NPTH slot
# width minimum is 1.00 mm. Oval drill size is checked on the minor axis.
(rule "JLCPCB plated slot width"
    (condition "A.Pad_Type == 'Through-hole' && A.Hole_Size_X != A.Hole_Size_Y")
    (constraint hole_size (min 0.35mm)))

(rule "JLCPCB NPTH slot width"
    (condition "A.Pad_Type == 'NPTH, mechanical' && A.Hole_Size_X != A.Hole_Size_Y")
    (constraint hole_size (min 1.00mm)))

# JLCPCB's published pad-to-silkscreen gap is 0.15 mm.
(rule "JLCPCB silkscreen clearance"
    (constraint silk_clearance (min 0.15mm)))

# Visible legend text must meet JLCPCB's 1.0 mm height and 0.15 mm stroke.
(rule "JLCPCB front legend text"
    (layer "F.SilkS")
    (constraint text_height (min 1.00mm))
    (constraint text_thickness (min 0.15mm)))

(rule "JLCPCB back legend text"
    (layer "B.SilkS")
    (constraint text_height (min 1.00mm))
    (constraint text_thickness (min 0.15mm)))

# JLCPCB's minimum legend graphic line width is 0.15 mm.
(rule "JLCPCB front legend lines"
    (condition "A.Type == 'Graphic' && A.Layer == 'F.SilkS' && A.Line_Width > 0mm")
    (constraint assertion "A.Line_Width >= 0.15mm"))

(rule "JLCPCB back legend lines"
    (condition "A.Type == 'Graphic' && A.Layer == 'B.SilkS' && A.Line_Width > 0mm")
    (constraint assertion "A.Line_Width >= 0.15mm"))
